# Function to draw a rectangle
def rectangle(x, y, width, height, color):
    t.penup()
    t.goto(x, y)
    t.color(color)
    t.pendown()
    t.begin_fill()

    t.goto(x + width, y)
    t.goto(x + width, y + height)
    t.goto(x, y + height)
    t.goto(x, y)

    t.end_fill()
    t.penup()


# Function to draw a circle
def circle(x, y, size, color):
    t.penup()
    t.goto(x, y - size)
    t.color(color)
    t.pendown()
    t.begin_fill()
    t.circle(size)
    t.end_fill()
    t.penup()


# Function to draw a line
def line(x1, y1, x2, y2, color, width):
    t.penup()
    t.goto(x1, y1)
    t.pendown()
    t.color(color)
    t.pensize(width)
    t.goto(x2, y2)
    t.penup()
    t.pensize(1)
# Function to draw a triangle
def triangle(points, color):
    t.penup()
    t.goto(points[0])
    t.color(color)
    t.pendown()
    t.begin_fill()

    for point in points[1:]:
        t.goto(point)

    t.goto(points[0])
    t.end_fill()
    t.penup()


